rules_version = '2';
// Reglas de Delicias Belgi.
// - El menú público (productos, categorías y configuración) se puede leer sin iniciar sesión.
// - Todo lo demás solo lo usa el personal: cuentas de Firebase Auth (no anónimas) con un
//   documento activo en /usuarios/{uid}.
// - Categorías, configuración y usuarios solo los cambia un administrador.
// IMPORTANTE: este archivo no se publica solo. Para aplicarlo hay que pegarlo en
// Firebase Console > Firestore Database > Reglas (o usar `firebase deploy --only firestore:rules`).
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }
    function userDoc() {
      return /databases/$(database)/documents/usuarios/$(request.auth.uid);
    }
    function isStaff() {
      return isAuth() && exists(userDoc()) && get(userDoc()).data.activo != false;
    }
    function isAdmin() {
      return isStaff() && get(userDoc()).data.role == 'admin';
    }
    function myEmail() {
      return request.auth.token.email.lower();
    }
    function preDoc() {
      return /databases/$(database)/documents/usuarios/$(myEmail());
    }

    // Menú público
    match /productos/{id}    { allow read: if true; allow write: if isStaff(); }
    match /products/{id}     { allow read: if true; allow write: if isStaff(); }
    match /categorias/{id}   { allow read: if true; allow write: if isAdmin(); }
    match /configuracion/{id}{ allow read: if true; allow write: if isAdmin(); }

    // Usuarios del panel
    match /usuarios/{userId} {
      allow read: if isAuth();
      // Al primer inicio de sesión: el usuario crea su propio documento como "caja",
      // o con el rol que el administrador le dejó preparado en /usuarios/{correo}.
      allow create: if isAdmin() || (
        isAuth() && request.auth.uid == userId
        && request.resource.data.email == myEmail()
        && (
          request.resource.data.role == 'caja'
          || (exists(preDoc()) && get(preDoc()).data.role == request.resource.data.role)
        )
      );
      allow update: if isAdmin();
      // El usuario puede borrar el registro previo que el administrador creó con su correo.
      allow delete: if isAdmin() || (isAuth() && resource.data.email == myEmail());
    }

    // Operación diaria (admin y caja)
    match /ventas/{id}                 { allow read, write: if isStaff(); }
    match /orders/{id}                 { allow read, write: if isStaff(); }
    match /pedidos/{id}                { allow read, write: if isStaff(); }
    match /clientes/{id}               { allow read, write: if isStaff(); }
    match /movimientos_inventario/{id} { allow read, write: if isStaff(); }
    match /inventario_movimientos/{id} { allow read, write: if isStaff(); }
    match /producciones/{id}           { allow read, write: if isStaff(); }
  }
}
